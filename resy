#!/bin/sh
# Launcher: ./resy            → menus
#           ./resy check      → any classic subcommand
# Works from any directory; sets up .venv on first run.
cd "$(dirname "$0")" || exit 1
if [ ! -x .venv/bin/python ]; then
  echo "First run: setting up .venv…"
  python3 -m venv .venv && .venv/bin/pip install -q --disable-pip-version-check -r requirements.txt || exit 1
fi
exec .venv/bin/python -m resybot "$@"
